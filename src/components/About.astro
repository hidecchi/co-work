---
const features = [
  "会員登録不要",
  "高速Wi-Fi",
  "電源完備",
  "席時間無制限",
  "仕事・勉強",
  "無人",
  "ドリンク持込OK",
  "会話OK",
];
---

<section class="about" id="about" aria-label="店舗の特徴">
  <div class="about__inner">
    <h2 class="about__title">
      三宮磯上公園北側のエリアに新しいコワーキングスペースが登場！<br
      />作業目的でも休憩目的でも快適に過ごせます。
    </h2>
    <ul class="about__list">
      {
        features.map((label) => (
          <li class="about__item">
            <span class="about__check" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none">
                <circle
                  cx="10"
                  cy="10"
                  r="9"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 10.2 8.6 12.8 14.2 7.2"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="about__label">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    padding: 3.5rem 1.5rem 4.5rem;
    background: #fff;
  }

  .about__title {
    margin-bottom: 2em;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }

  .about__inner {
    max-width: 1040px;
    margin: 0 auto;
  }

  .about__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.25rem 1.375rem;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
  }

  .about__check {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    color: #1a1a1a;
  }

  .about__check svg {
    width: 100%;
    height: 100%;
  }

  .about__label {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }

  @media (max-width: 768px) {
    .about {
      padding: 2.5rem 1.25rem 3.5rem;
    }

    .about__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.125rem;
    }

    .about__item {
      padding: 0.8rem;
    }

    .about__check {
      width: 1.5rem;
      height: 1.5rem;
    }

    .about__label {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 400px) {
    .about__list {
      gap: 1rem;
    }
  }
</style>
