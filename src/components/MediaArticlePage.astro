---
import { render } from "astro:content";
import { getHomePath, getMediaPath, type Lang, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { formatMediaListDate, type MediaPost } from "../utils/media";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Lang;
  post: MediaPost;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
const listPath = getMediaPath(lang);
const homePath = getHomePath(lang);
const published = post.data.pubDate;
const modified = post.data.updatedDate ?? published;
---

<Layout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  imageAlt={post.data.heroImageAlt}
  ogType="article"
  keywords={post.data.keywords}
  publishedTime={published}
  modifiedTime={modified}
>
  <Header lang={lang} />
  <div class="article-page-wrap">
    <nav class="breadcrumb" aria-label={t.media.breadcrumbLabel}>
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={homePath} class="breadcrumb__link breadcrumb__link--home">
            {t.media.breadcrumbHome}
          </a>
        </li>
        <li class="breadcrumb__item">
          <a href={listPath} class="breadcrumb__link">
            {t.media.label}
          </a>
        </li>
        <li class="breadcrumb__item">
          <span class="breadcrumb__current" aria-current="page">
            {post.data.title}
          </span>
        </li>
      </ol>
    </nav>

    <main id="main-content" class="article-page">
    <article class="article">
      <p class="article__back">
        <a href={listPath}>{t.media.backToList}</a>
      </p>
      <header class="article__header">
        <p class="article__meta">
          <span class="visually-hidden">{t.media.publishedOn}</span>
          <time datetime={published.toISOString()}>
            {formatMediaListDate(published)}
          </time>
          {post.data.badge && (
            <span class="article__badge">{post.data.badge}</span>
          )}
        </p>
        <h1 class="article__title">{post.data.title}</h1>
      </header>
      {
        post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? ""}
            class="article__hero"
            width="1200"
            height="675"
            decoding="async"
          />
        )
      }
      <div class="article__body">
        <Content />
      </div>
    </article>
    </main>
  </div>
  <Footer lang={lang} />
  <LanguageSwitch lang={lang} />
</Layout>

<style>
  .article-page-wrap {
    padding-top: 7rem;
  }

  .breadcrumb {
    background: #fff;
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 49px;
    list-style: none;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: #666;
    min-width: 0;
  }

  .breadcrumb__link {
    position: relative;
    padding: 0 1.75rem 0 0.75rem;
    color: #666;
    white-space: nowrap;
  }

  .breadcrumb__link--home {
    padding-left: 0;
  }

  .breadcrumb__link::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.375rem;
    width: 0.375rem;
    height: 0.375rem;
    border-top: 1px solid #bbb;
    border-right: 1px solid #bbb;
    transform: translateY(-50%) rotate(45deg);
  }

  .breadcrumb__current {
    color: #000;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 20rem;
  }

  .article-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    background: #fff;
    font-size: 1.125rem;
  }

  .article {
    margin: 0;
  }

  .article__back {
    margin: 0 0 1.75rem;
  }

  .article__back a {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #0077ff;
    text-decoration: underline;
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: #888;
    letter-spacing: 0.04em;
  }

  .article__title {
    margin: 0 0 1.75rem;
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  .article__badge {
    flex-shrink: 0;
    display: inline-block;
    padding: 0.12em 0.45em;
    border-radius: 0.2rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: #fff;
    background: #e53935;
  }

  .article__hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 2.25rem;
    background: #f5f5f5;
  }

  .article__body :global(> *:first-child) {
    margin-top: 0;
  }

  .article__body :global(h2) {
    margin: 2.25rem 0 1rem;
    font-size: 1.475rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .article__body :global(h3) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .article__body :global(p) {
    margin: 0 0 1.15rem;
    font-size: 1.125rem;
    line-height: 1.9;
  }

  .article__body :global(a) {
    color: #0077ff;
    text-decoration: underline;
  }

  .article__body :global(strong) {
    font-weight: 700;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .article__body :global(ul) {
    list-style: disc;
  }

  .article__body :global(ol) {
    list-style: decimal;
  }

  .article__body :global(li) {
    margin: 0 0 0.4rem;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .article__body :global(li::marker) {
    color: #666;
  }

  .article__body :global(table) {
    width: 100%;
    margin: 0 0 1.5rem;
    border-collapse: collapse;
    font-size: 1.075rem;
  }

  .article__body :global(th),
  .article__body :global(td) {
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    text-align: left;
    vertical-align: top;
  }

  .article__body :global(th) {
    background: #f5f5f5;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .article-page-wrap {
      padding-top: 5.75rem;
    }

    .breadcrumb__list {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .breadcrumb__current {
      max-width: 10rem;
    }

    .article-page {
      padding: 2rem 1.5rem 3.5rem;
    }

    .article__title {
      font-size: 1.525rem;
    }

    .article__body :global(h2) {
      font-size: 1.325rem;
    }
  }
</style>
