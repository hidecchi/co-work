---
const services = [
	{
		title: "マーケティング戦略",
		description:
			"市場分析・競合調査をもとに、事業目標に直結するマーケティング戦略を策定。KPI設計から実行計画まで一貫してサポートします。",
		image:
			"https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=500&fit=crop",
	},
	{
		title: "広告運用",
		description:
			"検索広告・SNS広告・ディスプレイ広告など、最適なチャネル選定と運用改善で集客効率を最大化。データに基づく継続的な最適化を行います。",
		image:
			"https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=500&fit=crop",
	},
	{
		title: "Web制作・ブランディング",
		description:
			"コーポレートサイト、LP、ブランドサイトの企画・設計・制作。ユーザー体験とブランド価値を両立したWebコミュニケーションを構築します。",
		image:
			"https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=800&h=500&fit=crop",
	},
];
---

<section class="services" id="services">
	<div class="services__inner">
		<p class="section-label">SERVICES</p>
		<h2 class="services__heading">事業成長を支える<br>3つのサービス</h2>

		<div class="services__grid">
			{services.map((service, index) => (
					<article class="service-card">
						<div class="service-card__image">
							<img src={service.image} alt={service.title} width="800" height="500" loading="lazy" />
						</div>
						<div class="service-card__body">
							<span class="service-card__num">{String(index + 1).padStart(2, '0')}</span>
							<h3 class="service-card__title">{service.title}</h3>
							<p class="service-card__desc">{service.description}</p>
						</div>
					</article>
				))}
		</div>
	</div>
</section>

<style>
.services {
	padding: 6rem 2rem;
	background: #fafafa;
}

.services__inner {
	max-width: 1100px;
	margin: 0 auto;
}

.services__heading {
	font-size: clamp(1.75rem, 4vw, 2.5rem);
	font-weight: 700;
	line-height: 1.5;
	margin: 0 0 3.5rem;
	letter-spacing: 0.02em;
}

.services__grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 2rem;
}

.service-card {
	background: #fff;
	overflow: hidden;
}

.service-card__image {
	aspect-ratio: 16 / 10;
	overflow: hidden;
}

.service-card__image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

.service-card:hover .service-card__image img {
	transform: scale(1.03);
}

.service-card__body {
	padding: 1.75rem 0 0;
}

.service-card__num {
	font-size: 0.75rem;
	font-weight: 600;
	letter-spacing: 0.1em;
	color: #aaa;
}

.service-card__title {
	font-size: 1.125rem;
	font-weight: 700;
	margin: 0.5rem 0 1rem;
}

.service-card__desc {
	font-size: 0.875rem;
	color: #555;
	line-height: 1.9;
	margin: 0;
}

@media (max-width: 900px) {
	.services__grid {
		grid-template-columns: 1fr;
		gap: 3rem;
	}
}
</style>
