---
import {
  getContactPath,
  getHomePath,
  getMediaPath,
  type Lang,
  useTranslations,
} from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);
---

<footer class="footer">
  <div class="footer__inner">
    <a href={homePath} class="logo">
      <img
        src="/logo-white2.png"
        alt=""
        class="logo__mark"
        width="180"
        height="168"
        decoding="async"
      />
      <span class="logo__text">{t.information.name}</span>
    </a>

    <nav class="footer__nav" aria-label={t.footer.navLabel}>
      <ul class="footer__nav-list">
        <li><a href={`${homePath}#howToUse`}>{t.header.navHowToUse}</a></li>
        <li><a href={`${homePath}#information`}>{t.header.navInformation}</a></li>
        <li><a href={getMediaPath(lang)}>{t.header.navMedia}</a></li>
        <li><a href={getContactPath(lang)}>{t.header.navContact}</a></li>
      </ul>
    </nav>

    <p class="footer__copy">
      &copy; {new Date().getFullYear()}&nbsp;
      {t.footer.copyright}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    background-color: #444444;
    color: white;
    position: relative;
  }

  .footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .logo__mark {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .footer__nav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__nav a {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: opacity 0.2s;
  }

  .footer__nav a:hover {
    opacity: 0.6;
  }

  .footer__copy {
    font-size: 0.75rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2rem 1.5rem 4.5rem;
    }
  }
</style>
