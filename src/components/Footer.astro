---
import {
  getContactPath,
  getHomePath,
  getMediaPath,
  type Lang,
  useTranslations,
} from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);
const contactPath = getContactPath(lang);

const menuItems = [
  { label: t.header.navHowToUse, href: `${homePath}#howToUse` },
  { label: t.header.navInformation, href: `${homePath}#information` },
  { label: t.header.navMedia, href: getMediaPath(lang) },
];
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__top">
      <nav class="footer__group" aria-label={t.footer.navLabel}>
        <ul class="footer__links">
          {
            menuItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__group">
        <ul class="footer__links">
          <li>
            <a href={contactPath}>{t.header.navContact}</a>
          </li>
        </ul>
        <address class="footer__address">
          <span>{t.information.addressLine1}</span>
          <span>{t.information.addressLine2}</span>
          <span>{t.information.addressNote}</span>
        </address>
      </div>
    </div>

    <p class="footer__brand" aria-hidden="true">ONE COIN COWORKING</p>

    <div class="footer__bar">
      <a href={`${contactPath}#contact-privacy-heading`}>{t.footer.privacy}</a>
      <p class="footer__copy">
        &copy; {new Date().getFullYear()}&nbsp;{t.footer.copyright}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-image:
      linear-gradient(
        to bottom,
        #ffffff 0%,
        #ffffff 69%,
        rgba(246, 244, 241, 0) 88%
      ),
      linear-gradient(90deg, #fff1b0 0%, #fbffc0 48%, #f3f6c6 100%);
  }

  .footer__container {
    max-width: 120rem;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1%;
    color: #1a1a1a;
  }

  .footer__top {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(4rem, 14vw, 12rem);
    row-gap: 2.5rem;
    max-width: 72rem;
    margin: 0;
    padding: 0 1%;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a,
  .footer__bar a {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #1a1a1a;
  }

  .footer__address {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 24rem;
    margin: 0.6rem 0 0;
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #1a1a1a;
  }

  .footer__brand {
    display: block;
    width: 100%;
    margin: clamp(6rem, 14vw, 10rem) 0 0;
    color: #1a1a1a;
    font-size: clamp(1rem, 9.5vw, 11.6rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.78;
  }

  .footer__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 0 1% 0.25rem;
    font-size: 0.9rem;
  }

  .footer__bar a {
    font-weight: 400;
  }

  .footer__copy {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer {
      background-image:
        linear-gradient(
          to bottom,
          #ffffff 0%,
          #ffffff 54%,
          rgba(246, 244, 241, 0) 88%
        ),
        linear-gradient(90deg, #fff1b0 0%, #fbffc0 48%, #f3f6c6 100%);
    }
    .footer__container {
      padding: 3rem 1% 5.5rem;
    }

    .footer__top {
      grid-template-columns: 1fr;
      row-gap: 2.25rem;
      margin-left: 0;
    }

    .footer__brand {
      margin-top: 3.5rem;
    }

    .footer__bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
  @media (max-width: 768px) {
    .footer__container {
      padding: 3rem 1.5rem 5.5rem;
    }
    .footer__brand {
      font-size: 8.5vw;
    }
  }
</style>
