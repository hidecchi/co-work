---
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="howToUse__container">
  <div class="howToUse__bg__top"></div>
  <section class="howToUse" id="howToUse" aria-labelledby="how-to-use-heading">
    <div class="howToUse__inner">
      <p class="howToUse__label" aria-hidden="true">{t.howToUse.label}</p>
      <h2 id="how-to-use-heading" class="howToUse__heading">{t.howToUse.heading}</h2>

      <div class="howToUse__list">
        {
          t.howToUse.steps.map((service, index) => (
            <article
              class="howToUse__item"
              aria-labelledby={`how-to-use-step-${index + 1}`}
            >
              <div class="howToUse__item__body">
                <span class="howToUse__item__num" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3
                  id={`how-to-use-step-${index + 1}`}
                  class="howToUse__item__title"
                >
                  {service.title}
                </h3>
                <p class="howToUse__item__desc">{service.description}</p>
              </div>
              <div class="howToUse__item__image">
                <div class="howToUse__item__image-reveal" data-image-reveal>
                  <img
                    src={service.image}
                    alt={service.title}
                    width="800"
                    height="500"
                    decoding="async"
                  />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <div class="howToUse__bg__bottom"></div>
</div>

<style>
  .howToUse__bg__top,
  .howToUse__bg__bottom {
    background: #f7f7f7;
    height: min(20rem, 30vw);
    width: 100%;
    border-radius: 50%;
    position: relative;
    z-index: -1;
  }

  .howToUse__bg__top {
    margin-bottom: max(-10rem, -15vw);
  }

  .howToUse__bg__bottom {
    margin-top: max(-10rem, -15vw);
  }

  .howToUse {
    padding: 6rem 2rem;
    background: #f7f7f7;
  }

  .howToUse__inner {
    max-width: 1500px;
    margin: 0 auto;
  }

  .howToUse__label {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .howToUse__heading {
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 0;
    letter-spacing: 0.02em;
  }

  .howToUse__list {
    margin-top: 3.5rem;
  }

  .howToUse__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .howToUse__item:first-child {
    border-top: 1px solid #e0e0e0;
  }

  .howToUse__item__body {
    flex-basis: 48%;
    min-width: 0;
    padding-left: 2%;
  }

  .howToUse__item__num {
    display: block;
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .howToUse__item__title {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 1.25rem;
    letter-spacing: 0.02em;
  }

  .howToUse__item__desc {
    color: #444;
    line-height: 1.9;
    margin: 0;
    white-space: pre-wrap;
    font-size: 1.1rem;
  }

  .howToUse__item__image {
    flex: 0 0 42%;
    max-width: 620px;
    height: 20rem;
    border-radius: 4px;
    container-type: inline-size;
    overflow: hidden;
  }

  .howToUse__item__image-reveal {
    width: 0;
    height: 100%;
    overflow: hidden;
    transition: width 1.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .howToUse__item__image-reveal.is-revealed {
    width: 100%;
  }

  .howToUse__item__image-reveal img {
    display: block;
    width: 100cqw;
    height: 20rem;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .howToUse {
      padding: 2rem 1.5rem;
    }

    .howToUse__list {
      margin-top: 2.5rem;
    }

    .howToUse__item {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      padding: 1.6rem 0;
    }

    .howToUse__item__num {
      font-size: 1.5rem;
    }

    .howToUse__item__image {
      flex: none;
      max-width: none;
      height: auto;
      max-height: 20rem;
      aspect-ratio: 16/11;
      order: -1;
    }

    .howToUse__item__image-reveal {
      width: 100%;
      transition: none;
    }
  }
</style>

<script>
  const MOBILE_BREAKPOINT = 768;

  function initImageReveal() {
    const reveals = document.querySelectorAll("[data-image-reveal]");
    if (!reveals.length) return;

    if (window.matchMedia(`(max-width: ${MOBILE_BREAKPOINT}px)`).matches) {
      reveals.forEach((reveal) => reveal.classList.add("is-revealed"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.25, rootMargin: "0px 0px -8% 0px" },
    );

    reveals.forEach((reveal) => observer.observe(reveal));
  }

  initImageReveal();
  document.addEventListener("astro:page-load", initImageReveal);
</script>
