---
import { HERO_SLIDES, heroSlideSrc } from "../config/heroSlides";
import { getHomePath, type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}

const lang = Astro.props.lang;
const t = useTranslations(lang);
const homePath = getHomePath(lang);
const howToUseHref = `${homePath}#howToUse`;
const accessHref = `${homePath}#information`;

const loopSlides = [...HERO_SLIDES, ...HERO_SLIDES, ...HERO_SLIDES];
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="hero-heading" class="hero__title">
        <span class="hero__title-line">{t.hero.titleLine1}</span>
        <span class="hero__title-line">{t.hero.titleLine2}</span>
      </h1>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <div class="hero__actions">
        <a class="hero__btn hero__btn--primary" href={howToUseHref}>
          <span>{t.hero.ctaPrimary}</span>
          <span class="hero__btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="hero__btn hero__btn--secondary" href={accessHref}>
          <span>{t.hero.ctaSecondary}</span>
          <span class="hero__btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero__gallery" data-hero-slider>
      <div class="hero__track" data-hero-track>
        {
          loopSlides.map((slide, index) => {
            const original = index % HERO_SLIDES.length;
            const isClone = index >= HERO_SLIDES.length;
            return (
              <figure class="hero__slide" aria-hidden={isClone ? "true" : undefined}>
                <img
                  src={heroSlideSrc(slide.file)}
                  alt={isClone ? "" : t.hero.slideAlts[original]}
                  width="840"
                  height="1120"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </figure>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0 80V64C360 8 1080 8 1440 64V80H0Z" fill="#ffffff"></path>
    </svg>
  </div>
</section>

<script>
  import { initHeroSlider } from "../scripts/heroSlider";

  const dispose = initHeroSlider(
    document.querySelector<HTMLElement>("[data-hero-slider]"),
  );
  document.addEventListener("astro:before-swap", dispose, { once: true });
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-left: clamp(1.5rem, 5.5vw, 5rem);
  }

  .hero__title {
    margin: 0 0 1.5rem;
    font-family: "Poppins", "Zen Kaku Gothic New", sans-serif;
    font-size: clamp(2.5rem, 4.45vw, 4rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0;
    color: #222;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .hero__tagline {
    margin: 0 0 2.5rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: #222;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 17.5rem);
    height: 3.5rem;
    padding: 0 3rem;
    border-radius: 30px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: opacity 0.2s;
  }

  .hero__btn-arrow {
    font-size: 1.25rem;
    line-height: 1;
  }

  .hero__btn--primary {
    background: #222;
    color: #fff;
    border: 1px solid #222;
  }

  .hero__btn--secondary {
    background: transparent;
    color: #222;
    border: 1px solid #222;
  }

  .hero__gallery {
    overflow: hidden;
    min-width: 0;
  }

  .hero__track {
    --slide-gap: 1.5rem;
    display: flex;
    gap: var(--slide-gap);
    will-change: transform;
  }

  .hero__slide {
    flex: 0 0 clamp(16rem, 29vw, 26.25rem);
    aspect-ratio: 420 / 535;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    background: #e9e4da;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__wave {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    line-height: 0;
  }

  .hero__wave svg {
    display: block;
    width: 100%;
    height: clamp(2.5rem, 6vw, 5.5rem);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
      padding-left: 0;
    }

    .hero__copy {
      padding-inline: 1.5rem;
    }

    .hero__title {
      font-size: clamp(2.25rem, 10vw, 3.25rem);
    }

    .hero__tagline {
      margin-bottom: 2rem;
      font-size: 0.9375rem;
    }

    .hero__gallery {
      padding-left: 1.5rem;
    }

    .hero__track {
      --slide-gap: 1rem;
    }

    .hero__slide {
      flex-basis: min(68vw, 20rem);
      border-radius: 20px;
    }
  }
</style>
