---
import { type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero__bg-text" aria-label={t.hero.h1}>
    {
      t.hero.bgText.split("").map((char, index) => {
        const glyph = char === " " ? "\u00A0" : char;
        return (
          <span
            class="hero__bg-char"
            style={`--char-index: ${index}`}
            aria-hidden="true"
          >
            <span class="hero__bg-char-front">{glyph}</span>
            <span class="hero__bg-char-flip">{glyph}</span>
          </span>
        );
      })
    }
  </h1>

  <div class="hero__content">
    <div class="hero__text">
      <div class="hero__vertical-reveal hero__vertical-reveal--right">
        <p
          class:list={["hero__vertical", lang === "en" && "hero__vertical--en"]}
        >
          {
            lang === "ja" ? (
              <>
                {t.hero.entryFeePrefix}
                <span class="hero__number">500</span>
                {t.hero.entryFeeSuffix}
              </>
            ) : (
              <>
                <span class="hero__number">¥500</span>
                {t.hero.entryFeeSuffix}
              </>
            )
          }
        </p>
      </div>
      <div class="hero__vertical-reveal hero__vertical-reveal--left">
        <p
          class:list={["hero__vertical", lang === "en" && "hero__vertical--en"]}
        >
          {t.hero.unlimited}
        </p>
      </div>
    </div>

    <div class="hero__image-wrap">
      <img src="/clip.svg" alt="" class="hero_clip" aria-hidden="true" />
      <canvas
        class="hero__image hero__canvas"
        data-src="/sample.jpg"
        data-src-sp="/sample-sp.jpg"
        role="img"
        aria-label={t.hero.imageAlt}></canvas>
      <p class="hero__open-badge">
        <span class="hero__open-badge-label">{t.hero.openBadgeDate}</span>
        <span class="hero__open-badge-text">{t.hero.openBadgeText}</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { initHeroCanvas } from "../scripts/heroCanvas";

  const dispose = initHeroCanvas();
  document.addEventListener("astro:before-swap", dispose, { once: true });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
  }

  .hero__bg-text {
    margin: 0;
    position: absolute;
    bottom: 8%;
    left: 0;
    right: 0;
    width: max-content;
    margin-inline: auto;
    display: flex;
    font-size: clamp(3rem, 9vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 8;
    perspective: 800px;
  }

  .hero__bg-char {
    display: inline-block;
    transform-style: preserve-3d;
    transform: translateZ(-0.5lh) rotateX(90deg);
    animation: hero-bg-cube-flip 6.7s infinite;
    animation-delay: calc(var(--char-index) * 0.05s);
  }

  .hero__bg-char-front,
  .hero__bg-char-flip {
    display: block;
    height: 1lh;
    backface-visibility: hidden;
  }

  .hero__bg-char-front {
    position: relative;
    transform: translateZ(0.5lh);
  }

  .hero__bg-char-flip {
    position: absolute;
    inset: 0 auto auto 0;
    transform: rotateX(-90deg) translateZ(0.5lh);
  }

  @keyframes hero-bg-cube-flip {
    0% {
      transform: translateZ(-0.5lh) rotateX(90deg);
      animation-timing-function: cubic-bezier(0.22, 1.4, 0.32, 1);
    }

    12% {
      transform: translateZ(-0.5lh) rotateX(0deg);
      animation-timing-function: linear;
    }

    68% {
      transform: translateZ(-0.5lh) rotateX(0deg);
      animation-timing-function: cubic-bezier(0.22, 1.4, 0.32, 1);
    }

    80% {
      transform: translateZ(-0.5lh) rotateX(90deg);
      animation-timing-function: linear;
    }

    100% {
      transform: translateZ(-0.5lh) rotateX(90deg);
    }
  }

  .hero__content {
    position: relative;
    width: fit-content;
    margin: 0 auto;
  }

  .hero__text {
    position: absolute;
    left: 0;
    top: 20%;
    display: flex;
    align-items: flex-start;
    flex-direction: row-reverse;
    gap: 0.75rem;
    z-index: 5;
  }

  .hero__vertical-reveal {
    position: relative;
    font-weight: 500;
  }

  .hero__vertical {
    writing-mode: vertical-rl;
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    line-height: 1.3;
    margin: 0;
    padding: 1.25rem 0.875rem;
    background: #fff;
    border: 1px solid #444444;
    border-radius: 0.2rem;
    white-space: nowrap;
    height: fit-content;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__vertical--en {
    writing-mode: horizontal-tb;
    letter-spacing: 0.04em;
    line-height: 1.4;
    max-width: 8rem;
    white-space: normal;
    text-align: center;
  }

  .hero__number {
    writing-mode: horizontal-tb;
    text-orientation: mixed;
    display: inline-block;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0.3em 0;
  }

  .hero__vertical--en .hero__number {
    display: block;
    font-size: 1.35em;
    margin: 0 0 0.35em;
  }

  .hero__image-wrap {
    width: min(85vw, 1358px);
    aspect-ratio: 1158 / 869;
    position: relative;
  }

  .hero_clip {
    width: 100%;
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .hero__image,
  .hero__canvas {
    position: absolute;
    top: 1px;
    left: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    display: block;
    z-index: 1;
  }

  .hero__canvas--error {
    opacity: 0;
  }

  .hero__open-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding: 1.75rem 3.5rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1.5px solid #444444;
    border-radius: 0.35rem;
    box-shadow: 0 6px 32px rgba(0, 0, 0, 0.14);
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
    text-align: center;
    backdrop-filter: blur(6px);
  }

  .hero__open-badge-label {
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: #1a1a1a;
  }

  .hero__open-badge-text {
    font-size: clamp(1.125rem, 2.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.3em;
    line-height: 1;
    padding: 0.35em 0.9em;
    color: #1a1a1a;
    background: rgba(255, 232, 90, 0.85);
    border-radius: 0.15rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 6rem;
      min-height: auto;
    }

    .hero__text {
      left: 1rem;
      top: 15%;
      transform: none;
    }

    .hero__content {
      max-width: 100%;
      display: grid;
      justify-content: center;
    }

    .hero__vertical {
      font-size: 0.95rem;
      padding: 0.875rem 0.625rem;
    }

    .hero__vertical--en {
      max-width: 6.5rem;
      font-size: 0.85rem;
    }

    .hero__image-wrap {
      width: max(90vw, 520px);
      margin-top: 2rem;
    }

    .hero__open-badge {
      gap: 0.45rem;
      padding: 1.1rem 1.85rem;
    }

    .hero__open-badge-label {
      font-size: clamp(1.5rem, 4.5vw, 2rem);
    }

    .hero__open-badge-text {
      font-size: clamp(0.875rem, 2.2vw, 1.0625rem);
      padding: 0.3em 0.75em;
      letter-spacing: 0.12em;
    }

    .hero__bg-text {
      bottom: 4%;
      font-size: clamp(2rem, 9vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg-char {
      animation: none;
      transform: translateZ(-0.5lh) rotateX(0deg);
    }
  }
</style>
