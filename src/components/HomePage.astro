---
import { HERO_SLIDE_PRELOAD } from "../config/heroSlides";
import { type Lang, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import About from "./About.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import HowToUse from "./HowToUse.astro";
import Information from "./Information.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import RecruitmentBanner from "./RecruitmentBanner.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title={t.seo.title}
  description={t.seo.description}
  imageAlt={t.seo.ogImageAlt}
  heroImagePreload={HERO_SLIDE_PRELOAD}
>
  <div class="home-hero-shell">
    <Header lang={lang} cream />
    <Hero lang={lang} />
  </div>
  <main id="main-content">
    <About lang={lang} />
    <HowToUse lang={lang} />
    <Information lang={lang} />
  </main>
  <Footer lang={lang} />
  <LanguageSwitch lang={lang} />
  <RecruitmentBanner lang={lang} />
</Layout>

<style>
  .home-hero-shell {
    background: #f9f6f1;
  }
</style>
