---
import { contactFormAction } from "../config/contact";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<form class="contact-form" action={contactFormAction} method="post">
  <div class="contact-form__field">
    <label for="contact-name">{t.contact.nameLabel}</label>
    <input id="contact-name" type="text" name="お名前" autocomplete="name" />
  </div>

  <div class="contact-form__field">
    <label for="contact-email">
      {t.contact.emailLabel}
      <span class="contact-form__required">{t.contact.required}</span>
    </label>
    <input
      id="contact-email"
      type="email"
      name="メールアドレス"
      autocomplete="email"
      required
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-phone">{t.contact.phoneLabel}</label>
    <input
      id="contact-phone"
      type="tel"
      name="電話番号"
      autocomplete="tel"
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-company">{t.contact.companyLabel}</label>
    <input
      id="contact-company"
      type="text"
      name="会社名"
      autocomplete="organization"
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-message">
      {t.contact.messageLabel}
      <span class="contact-form__required">{t.contact.required}</span>
    </label>
    <textarea
      id="contact-message"
      name="お問い合わせ内容"
      rows="8"
      required></textarea>
  </div>

  <button type="submit" class="contact-form__submit">{t.contact.submit}</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .contact-form__field label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }

  .contact-form__required {
    display: inline-block;
    padding: 0.12em 0.45em;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: #fff;
    background: #e53935;
    border-radius: 0.2rem;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    font: inherit;
    color: #1a1a1a;
    background: #fff;
    border: 1px solid #ccc;
    border-radius: 0.25rem;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: 2px solid #444;
    outline-offset: 1px;
    border-color: #444;
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 10rem;
  }

  .contact-form__submit {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #fff;
    background: #444;
    border-radius: 0.25rem;
  }

  .contact-form__submit:hover {
    opacity: 0.85;
  }
</style>
