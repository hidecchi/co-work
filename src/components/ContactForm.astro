---
import { contactFormAction } from "../config/contact";
import { type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<form class="contact-form" action={contactFormAction} method="post">
  <div class="contact-form__field">
    <label for="contact-name">{t.contact.nameLabel}</label>
    <input id="contact-name" type="text" name="お名前" autocomplete="name" />
  </div>

  <div class="contact-form__field">
    <label for="contact-email">
      {t.contact.emailLabel}
      <span class="contact-form__required">{t.contact.required}</span>
    </label>
    <input
      id="contact-email"
      type="email"
      name="メールアドレス"
      autocomplete="email"
      required
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-phone">{t.contact.phoneLabel}</label>
    <input id="contact-phone" type="tel" name="電話番号" autocomplete="tel" />
  </div>

  <div class="contact-form__field">
    <label for="contact-company">{t.contact.companyLabel}</label>
    <input
      id="contact-company"
      type="text"
      name="会社名"
      autocomplete="organization"
    />
  </div>

  <div class="contact-form__field">
    <label for="contact-message">
      {t.contact.messageLabel}
      <span class="contact-form__required">{t.contact.required}</span>
    </label>
    <textarea id="contact-message" name="お問い合わせ内容" rows="8" required
    ></textarea>
  </div>

  <div class="contact-form__privacy">
    <h2 class="contact-form__privacy-heading" id="contact-privacy-heading">
      {t.contact.privacyHeading}
    </h2>
    <div
      class="contact-form__policy"
      role="region"
      aria-labelledby="contact-privacy-heading"
      tabindex="0"
    >
      <p class="contact-form__policy-intro">{t.contact.privacyIntro}</p>
      {
        t.contact.privacySections.map((section) => (
          <section class="contact-form__policy-section">
            <h3>{section.title}</h3>
            <p>{section.body}</p>
          </section>
        ))
      }
    </div>
    <div class="contact-form__agree">
      <input
        id="contact-privacy-agree"
        type="checkbox"
        name="プライバシーポリシーへの同意"
        value="同意する"
        required
      />
      <label for="contact-privacy-agree">
        {t.contact.privacyAgreeLabel}
        <span class="contact-form__required">{t.contact.required}</span>
      </label>
    </div>
  </div>

  <button type="submit" class="contact-form__submit">{t.contact.submit}</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .contact-form__field label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }

  .contact-form__required {
    display: inline-block;
    padding: 0.12em 0.45em;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: #fff;
    background: #e53935;
    border-radius: 0.2rem;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    font: inherit;
    color: #1a1a1a;
    background: #fff;
    border: 1px solid #ccc;
    border-radius: 0.25rem;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: 2px solid #1d1d1d;
    outline-offset: 1px;
    border-color: #1d1d1d;
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 10rem;
  }

  .contact-form__privacy {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .contact-form__privacy-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }

  .contact-form__policy {
    max-height: 14rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.75;
    color: #333;
    background: #fafafa;
    border: 1px solid #ccc;
    border-radius: 0.25rem;
  }

  .contact-form__policy:focus {
    outline: 2px solid #1d1d1d;
    outline-offset: 1px;
    border-color: #1d1d1d;
  }

  .contact-form__policy-intro {
    margin: 0 0 1rem;
  }

  .contact-form__policy-section {
    margin: 0 0 1rem;
  }

  .contact-form__policy-section:last-child {
    margin-bottom: 0;
  }

  .contact-form__policy-section h3 {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .contact-form__policy-section p {
    margin: 0;
  }

  .contact-form__agree {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .contact-form__agree input[type="checkbox"] {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.2rem 0 0;
    accent-color: #1d1d1d;
    cursor: pointer;
  }

  .contact-form__agree label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    cursor: pointer;
  }

  .contact-form__submit {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.875rem 2.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #fff;
    background: #1d1d1d;
    border: none;
    border-radius: 0;
  }

  .contact-form__submit:hover {
    background: #000;
    opacity: 1;
  }
</style>
