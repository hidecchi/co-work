---
import { type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="information"
  id="information"
  aria-labelledby="information-heading"
>
  <div class="information__inner">
    <div class="information__texts">
      <div class="information__header">
        <p class="information__title" aria-hidden="true">
          {t.information.label}
        </p>
        <h2 id="information-heading" class="information__subtitle">
          {t.information.heading}
        </h2>
      </div>
    </div>

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3280.5290695923113!2d135.1852299383103!3d34.69183326568901!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60008f1e0e1402d7%3A0xc143e7a338cfada1!2z44CSNjUwLTAwMDQg5YW15bqr55yM56We5oi45biC5Lit5aSu5Yy65Lit5bGx5omL6YCa77yU5LiB55uu77yR77yQ4oiS77yT77yR!5e0!3m2!1sja!2sjp!4v1786252205454!5m2!1sja!2sjp"
      width="1800"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title={t.information.mapTitle}
      class="information__map"></iframe>
    <dl class="information__list">
      <div class="information__list-item">
        <dt class="information__list-item-title">{t.information.nameLabel}</dt>
        <dd class="information__list-item-text">{t.information.name}</dd>
      </div>
      <div class="information__list-item">
        <dt class="information__list-item-title">
          {t.information.addressLabel}
        </dt>
        <dd class="information__list-item-text">
          {t.information.addressLine1}{" "}<br
            class="information__list-item-text__br"
          />{t.information.addressLine2}<br
            class="information__list-item-text__br"
          />{t.information.addressNote}
        </dd>
      </div>
      <div class="information__list-item">
        <dt class="information__list-item-title">{t.information.hoursLabel}</dt>
        <dd class="information__list-item-text">{t.information.hours}</dd>
      </div>
      <div class="information__list-item">
        <dt class="information__list-item-title">{t.information.seatsLabel}</dt>
        <dd class="information__list-item-text">{t.information.seats}</dd>
      </div>
      <div class="information__list-item">
        <dt class="information__list-item-title">
          {t.information.paymentLabel}
        </dt>
        <dd class="information__list-item-text">{t.information.payment}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .information {
    padding: 6rem 2rem;
  }

  .information__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .information__header {
    margin-bottom: 3rem;
  }

  .information__title {
    letter-spacing: 0.1em;
    line-height: 1.5;
    font-weight: 400;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .information__subtitle {
    font-weight: 500;
    font-size: 2rem;
    letter-spacing: 0.2em;
    line-height: 1.5;
    margin: 0;
  }

  .information__map {
    width: 100%;
    border: 0;
  }

  .information__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: #f5f5f5;
    padding: 1rem;
    font-size: 1.1rem;
  }

  .information__list-item {
    display: flex;
    gap: 0.4rem;
  }

  .information__list-item-title {
    flex-shrink: 0;
  }

  .information__list-item-title::before {
    content: "【";
  }

  .information__list-item-title::after {
    content: "】";
  }

  .information__list-item-text {
    margin: 0;
  }

  .information__list-item-text__br {
    display: none;
  }

  @media (max-width: 768px) {
    .information {
      padding: 3.2rem 1.5rem 1.6rem;
    }

    .information__subtitle {
      font-size: 1.5rem;
    }

    .information__header {
      margin-bottom: 2rem;
    }

    .information__list {
      padding: 1rem 0.5rem;
      font-size: 1rem;
    }

    .information__list-item {
      flex-direction: column;
      gap: 0;
    }

    .information__list-item-text {
      padding-left: 0.5rem;
    }

    .information__list-item-text__br {
      display: block;
    }
  }
</style>
