---
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const mapSrc =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3280.5290695923113!2d135.1852299383103!3d34.69183326568901!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60008f1e0e1402d7%3A0xc143e7a338cfada1!2z44CSNjUwLTAwMDQg5YW15bqr55yM56We5oi45biC5Lit5aSu5Yy65Lit5bGx5omL6YCa77yU5LiB55uu77yR77yQ4oiS77yT77yR!5e0!3m2!1sja!2sjp!4v1786252205454!5m2!1sja!2sjp";
const mapLink =
  "https://www.google.com/maps/search/?api=1&query=34.691833,135.185230";

const facts = [
  {
    key: "name",
    label: t.information.nameLabel,
    icon: "store",
  },
  {
    key: "address",
    label: t.information.addressLabel,
    icon: "pin",
  },
  {
    key: "hours",
    label: t.information.hoursLabel,
    icon: "clock",
    featured: true,
  },
  {
    key: "seats",
    label: t.information.seatsLabel,
    icon: "seat",
  },
] as const;
---

<section
  class="information"
  id="information"
  aria-labelledby="information-heading"
>
  <div class="information__inner">
    <div class="information__header">
      <p class="information__label" aria-hidden="true">
        {t.information.label}
      </p>
      <h2 id="information-heading" class="information__heading">
        {t.information.heading}
      </h2>
    </div>

    <div class="information__stage">
      <div class="information__panel">
        <dl class="information__facts">
          {
            facts.map((fact) => (
              <div
                class:list={[
                  "information__fact",
                  fact.featured && "information__fact--featured",
                ]}
              >
                <dt class="information__fact-label">
                  <span class="information__icon" aria-hidden="true">
                    {fact.icon === "store" && (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path
                          d="M4 10.5 5.2 6.8A1.5 1.5 0 0 1 6.64 5.8h10.72a1.5 1.5 0 0 1 1.44 1L20 10.5"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                        <path
                          d="M4 10.5h16v8.2a1.3 1.3 0 0 1-1.3 1.3H5.3A1.3 1.3 0 0 1 4 18.7v-8.2Z"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                        <path
                          d="M10 20V14.2h4V20"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                    {fact.icon === "pin" && (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path
                          d="M12 21s6.2-5.1 6.2-10.2A6.2 6.2 0 0 0 12 4.6a6.2 6.2 0 0 0-6.2 6.2C5.8 15.9 12 21 12 21Z"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                        <circle
                          cx="12"
                          cy="10.6"
                          r="2.1"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                      </svg>
                    )}
                    {fact.icon === "clock" && (
                      <svg viewBox="0 0 24 24" fill="none">
                        <circle
                          cx="12"
                          cy="12"
                          r="8.2"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                        <path
                          d="M12 7.8V12l3.1 2"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                    {fact.icon === "seat" && (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path
                          d="M6.5 10.2V7.6A2.6 2.6 0 0 1 9.1 5h5.8a2.6 2.6 0 0 1 2.6 2.6v2.6"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                        <path
                          d="M5 13.2h14a2 2 0 0 1 2 2v1.4H3v-1.4a2 2 0 0 1 2-2Z"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M5.4 16.6v2.6M18.6 16.6v2.6"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                      </svg>
                    )}
                  </span>
                  {fact.label}
                </dt>
                <dd class="information__fact-value">
                  {fact.key === "name" && t.information.name}
                  {fact.key === "address" && (
                    <>
                      <span class="information__postal">
                        {t.information.addressLine1}
                      </span>
                      <span>
                        {t.information.addressLine2}
                      </span>
                      <span class="information__note">
                        {t.information.addressNote}
                      </span>
                    </>
                  )}
                  {fact.key === "hours" && (
                    <span class="information__hours">{t.information.hours}</span>
                  )}
                  {fact.key === "seats" && t.information.seats}
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          class="information__cta"
          href={mapLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="information__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M7 17 17 7M9.5 7H17v7.5"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          {t.information.mapCta}
        </a>
      </div>

      <div class="information__map-frame">
        <iframe
          src={mapSrc}
          width="1800"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={t.information.mapTitle}
          class="information__map"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .information {
    padding: 6rem 2rem 7rem;
    background: #fff;
  }

  .information__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .information__header {
    margin-bottom: 2.75rem;
  }

  .information__label {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    font-weight: 400;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .information__heading {
    position: relative;
    display: inline-block;
    font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: 0.12em;
    line-height: 1.5;
    margin: 0;
  }

  .information__heading::after {
    content: "";
    display: block;
    width: 3.25rem;
    height: 0.28rem;
    margin-top: 0.85rem;
    background: rgba(255, 232, 90, 0.95);
    border-radius: 999px;
  }

  .information__stage {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  .information__panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem 1.6rem 1.6rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.07);
  }

  .information__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin: 0;
  }

  .information__fact {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    padding: 1rem 1rem 1.05rem;
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 8px;
  }

  .information__fact:nth-child(1),
  .information__fact:nth-child(2) {
    grid-column: 1 / -1;
  }

  .information__fact--featured {
    background: linear-gradient(
      180deg,
      rgba(255, 232, 90, 0.38) 0%,
      rgba(255, 232, 90, 0.16) 100%
    );
    border-color: rgba(210, 180, 20, 0.28);
  }

  .information__fact-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #666;
  }

  .information__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: #1a1a1a;
  }

  .information__icon svg {
    width: 100%;
    height: 100%;
  }

  .information__fact-value {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.65;
    color: #1a1a1a;
  }

  .information__postal {
    font-size: 0.9rem;
    font-weight: 500;
    color: #555;
  }

  .information__note {
    font-size: 0.875rem;
    font-weight: 500;
    color: #666;
  }

  .information__hours {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .information__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.95rem 1.25rem;
    border: 1.5px solid #444444;
    border-radius: 0.35rem;
    background: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #1a1a1a;
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      background 0.2s;
  }

  .information__cta-icon {
    display: flex;
    width: 1.05rem;
    height: 1.05rem;
  }

  .information__cta-icon svg {
    width: 100%;
    height: 100%;
  }

  .information__map-frame {
    position: relative;
    min-height: 28rem;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.07);
    background: #eef1f3;
  }

  .information__map {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 28rem;
    border: 0;
    filter: saturate(0.92) contrast(1.02);
  }

  @media (any-hover: hover) {
    .information__cta:hover {
      opacity: 1;
      background: rgba(255, 232, 90, 0.45);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
      transform: translateY(-1px);
    }
  }

  @media (max-width: 900px) {
    .information {
      padding: 3.5rem 1.5rem 4rem;
    }

    .information__header {
      margin-bottom: 2rem;
    }

    .information__stage {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .information__panel {
      padding: 1.25rem 1.1rem 1.15rem;
      order: 2;
    }

    .information__map-frame {
      min-height: 16.5rem;
      order: 1;
    }

    .information__map {
      min-height: 16.5rem;
    }

    .information__facts {
      gap: 0.75rem;
    }

    .information__fact-value {
      font-size: 1rem;
    }

    .information__hours {
      font-size: 1.45rem;
    }
  }

  @media (max-width: 520px) {
    .information__facts {
      grid-template-columns: 1fr;
    }

    .information__cta {
      font-size: 0.875rem;
      letter-spacing: 0.05em;
    }
  }
</style>
