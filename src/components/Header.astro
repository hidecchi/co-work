---
const navItems: { label: string; href: string; external?: boolean }[] = [
  { label: "ご利用方法", href: "#howToUse" },
  { label: "店舗情報", href: "#information" },
  // { label: "お問い合わせ", href: "#contact", external: true },
];
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="logo" aria-label="CO-WORK ホーム">
      <svg
        class="logo__mark"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M8 6C8 6 14 6 18 10C22 14 24 20 24 26C24 26 18 26 14 22C10 18 8 12 8 6Z"
          stroke="currentColor"
          stroke-width="2"
          fill="none"></path>
        <path
          d="M14 10C14 10 18 10 20 14C22 18 22 22 22 26"
          stroke="currentColor"
          stroke-width="2"
          fill="none"></path>
      </svg>
      <span class="logo__text">ONE COIN コワーキング</span>
    </a>

    <nav class="nav" aria-label="メインナビゲーション">
      <ul class="nav__list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link"
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
                {item.external && (
                  <svg
                    class="nav__external"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 9L9 3M9 3H4M9 3V8"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="menu-toggle"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label="モバイルナビゲーション"
    hidden
  >
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav__link"
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const mobileNav = document.querySelector("#mobile-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute(
      "aria-label",
      isOpen ? "メニューを開く" : "メニューを閉じる",
    );
    if (mobileNav) mobileNav.hidden = isOpen;
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (mobileNav) mobileNav.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "メニューを開く");
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1900px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .logo__mark {
    width: 1.75rem;
    height: 1.75rem;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: opacity 0.2s;
  }

  .nav__link:hover {
    opacity: 0.6;
  }

  .nav__external {
    width: 0.625rem;
    height: 0.625rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 0.375rem;
    width: 2rem;
    height: 2rem;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #1a1a1a;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: #fff;
    padding: 1rem 2rem 1.5rem;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .header__inner {
      padding: 1rem 1.5rem;
    }

    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav:not([hidden]) {
      display: block;
    }
  }
</style>
