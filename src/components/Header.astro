---
import {
  getContactPath,
  getHomePath,
  getMediaPath,
  type Lang,
  useTranslations,
} from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);

const navItems = [
  { label: t.header.navHowToUse, href: `${homePath}#howToUse` },
  { label: t.header.navInformation, href: `${homePath}#information` },
  { label: t.header.navMedia, href: getMediaPath(lang) },
  { label: t.header.navContact, href: getContactPath(lang) },
];

const socialLinks = [
  {
    label: "X",
    href: "https://x.com/one_coin_cowork",
    icon: "/icon-x.svg",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/one_coin_coworking/",
    icon: "/icon-insta.svg",
  },
  {
    label: "Threads",
    href: "https://www.threads.com/@one_coin_coworking",
    icon: "/icon-threads.svg",
  },
];
---

<header class="header">
  <div class="header__inner">
    <a href={homePath} class="logo">
      <img
        src="/logo.png"
        alt=""
        class="logo__mark"
        width="40"
        height="40"
        decoding="async"
      />
      <span class="logo__text">{t.information.name}</span>
    </a>

    <div class="header__actions">
      <nav class="nav" aria-label={t.header.mainNav}>
        <ul class="nav__list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="social">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="social__link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
              >
                <img
                  src={item.icon}
                  alt=""
                  class="social__icon"
                  width="18"
                  height="18"
                  decoding="async"
                />
              </a>
            </li>
          ))
        }
      </ul>

    <button
      class="menu-toggle"
      type="button"
      aria-label={t.header.menuOpen}
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-open={t.header.menuOpen}
      data-menu-close={t.header.menuClose}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label={t.header.mobileNav}
    hidden
  >
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav__link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="social social--menu">
      {
        socialLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="social__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <img
                src={item.icon}
                alt=""
                class="social__icon"
                width="18"
                height="18"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    z-index: 100;
    background: #fff;
    border-radius: 45px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1900px;
    margin: 0 auto;
    padding: 1rem 1.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  .logo__mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social--menu {
    display: none;
  }

  .social__link {
    display: flex;
    width: 18px;
    height: 18px;
  }

  .social__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: opacity 0.2s;
  }

  .nav__link:hover {
    opacity: 0.6;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 2rem;
    height: 2rem;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #1a1a1a;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: #fff;
    padding: 1rem 2rem 1.5rem;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .header {
      top: 0.75rem;
      left: 0.75rem;
      right: 0.75rem;
      border-radius: 28px;
    }

    .header__inner {
      padding: 0.75rem 1.25rem;
    }
    .logo {
      font-size: 0.9375rem;
    }

    .header__actions {
      gap: 0.85rem;
    }

    .header__actions > .social {
      display: none;
    }

    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav:not([hidden]) {
      display: block;
    }

    .mobile-nav:not([hidden]) .social--menu {
      display: flex;
      flex-direction: row;
      gap: 1.25rem;
      margin-top: 0.5rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
    }
  }
</style>
