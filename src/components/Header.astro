---
import {
  getContactPath,
  getHomePath,
  getMediaPath,
  type Lang,
  useTranslations,
} from "../i18n";

interface Props {
  lang: Lang;
  variant?: "default" | "landing";
}

const { lang, variant = "default" } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);
const isLanding = variant === "landing";

const defaultNavItems = [
  { label: t.header.navHowToUse, href: `${homePath}#howToUse` },
  { label: t.header.navInformation, href: `${homePath}#information` },
  { label: t.header.navMedia, href: getMediaPath(lang) },
  { label: t.header.navContact, href: getContactPath(lang) },
];

const landingNavItems = [
  { label: t.header.navAbout, href: `${homePath}#about` },
  { label: t.header.navHowToUse, href: `${homePath}#howToUse` },
  { label: t.header.navAmenities, href: `${homePath}#about` },
  { label: t.header.navAccess, href: `${homePath}#information` },
];

const navItems = isLanding ? landingNavItems : defaultNavItems;
const headerCtaHref = `${homePath}#howToUse`;

const siteName = t.information.name;
const logoSplit = siteName.lastIndexOf(" ");
const logoMain = logoSplit > 0 ? siteName.slice(0, logoSplit) : siteName;
const logoAccent = logoSplit > 0 ? siteName.slice(logoSplit + 1) : "";

const socialLinks = [
  {
    label: "X",
    href: "https://x.com/one_coin_cowork",
    icon: "/icon-x.svg",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/one_coin_coworking/",
    icon: "/icon-insta.svg",
  },
  {
    label: "Threads",
    href: "https://www.threads.com/@one_coin_coworking",
    icon: "/icon-threads.svg",
  },
];
---

<header class:list={["header", isLanding && "header--landing"]}>
  <div class="header__inner">
    <a href={homePath} class="logo" aria-label={siteName}>
      {
        isLanding ? (
          <span class="logo__text" aria-hidden="true">
            <span class="logo__main">{logoMain}</span>
            <span class="logo__accent">{logoAccent}</span>
          </span>
        ) : (
          <span class="logo__text">{siteName}</span>
        )
      }
    </a>

    <div class="header__actions">
      <nav class="nav" aria-label={t.header.mainNav}>
        <ul class="nav__list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="social">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="social__link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
              >
                <img
                  src={item.icon}
                  alt=""
                  class="social__icon"
                  width="18"
                  height="18"
                  decoding="async"
                />
              </a>
            </li>
          ))
        }
      </ul>

      {
        isLanding && (
          <a class="header__cta" href={headerCtaHref}>
            <span>{t.header.headerCta}</span>
            <span aria-hidden="true">→</span>
          </a>
        )
      }

    <button
      class="menu-toggle"
      type="button"
      aria-label={t.header.menuOpen}
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-open={t.header.menuOpen}
      data-menu-close={t.header.menuClose}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label={t.header.mobileNav}
    hidden
  >
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav__link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="social social--menu">
      {
        socialLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="social__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <img
                src={item.icon}
                alt=""
                class="social__icon"
                width="18"
                height="18"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    z-index: 100;
    background: #fff;
    border-radius: 45px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .header--landing {
    position: relative;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
  }

  .header--landing .header__inner {
    max-width: none;
    padding: 2rem clamp(1.5rem, 5.5vw, 5rem) 1.75rem;
  }

  .header--landing .logo {
    font-family: "Poppins", "Zen Kaku Gothic New", sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  .logo__accent {
    margin-left: 0.3em;
    background: linear-gradient(90deg, #18a15e, #039987);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .header--landing .nav__list {
    gap: 2rem;
  }

  .header--landing .nav__link {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #222;
  }

  .header--landing .header__actions > .social {
    display: none;
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.75rem;
    padding: 0 1.5rem;
    border-radius: 30px;
    background: linear-gradient(90deg, #18a15e, #039987);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1900px;
    margin: 0 auto;
    padding: 1rem 1.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social--menu {
    display: none;
  }

  .social__link {
    display: flex;
    width: 18px;
    height: 18px;
  }

  .social__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    transition: opacity 0.2s;
  }

  .nav__link:hover {
    opacity: 0.6;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 2rem;
    height: 2rem;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #1a1a1a;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: #fff;
    padding: 1rem 2rem 1.5rem;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .header {
      top: 0.75rem;
      left: 0.75rem;
      right: 0.75rem;
      border-radius: 28px;
    }

    .header__inner {
      padding: 0.75rem 1.25rem;
    }
    .logo {
      font-size: 0.9375rem;
    }

    .header__actions {
      gap: 0.85rem;
    }

    .header__actions > .social {
      display: none;
    }

    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav:not([hidden]) {
      display: block;
    }

    .header--landing {
      top: 0;
      left: 0;
      right: 0;
      border-radius: 0;
    }

    .header--landing .header__inner {
      padding: 1.25rem 1.5rem;
    }

    .header--landing .logo {
      font-size: 1.35rem;
    }

    .header--landing .header__cta {
      display: none;
    }

    .header--landing .menu-toggle {
      width: 3.25rem;
      height: 3.25rem;
      gap: 0.3rem;
      border: 1px solid #039987;
      border-radius: 50%;
    }

    .header--landing .menu-toggle span {
      width: 0.9rem;
      height: 1.5px;
      background: #039987;
    }

    .header--landing .mobile-nav {
      margin: 0 1.5rem;
      border-radius: 20px;
      border-top: none;
    }

    .mobile-nav:not([hidden]) .social--menu {
      display: flex;
      flex-direction: row;
      gap: 1.25rem;
      margin-top: 0.5rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
    }
  }
</style>
