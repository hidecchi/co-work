---
import {
  getContactPath,
  getFaqPath,
  getHomePath,
  getMediaPath,
  type Lang,
  useTranslations,
} from "../i18n";
import { en as enCopy } from "../i18n/en";
import { ja as jaCopy } from "../i18n/ja";

interface Props {
  lang: Lang;
  /** トップのみクリーム背景（ハンバーガー・モバイルメニュー） */
  cream?: boolean;
}

const { lang, cream = false } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);

const defaultNavItems = [
  {
    href: `${homePath}#howToUse`,
    ja: jaCopy.header.navHowToUse,
    en: enCopy.header.navHowToUse,
  },
  {
    href: `${homePath}#information`,
    ja: jaCopy.header.navInformation,
    en: enCopy.header.navInformation,
  },
  {
    href: getMediaPath(lang),
    ja: jaCopy.header.navMedia,
    en: enCopy.header.navMedia,
  },
  {
    href: getFaqPath(lang),
    ja: jaCopy.header.navFaq,
    en: enCopy.header.navFaq,
  },
  {
    href: getContactPath(lang),
    ja: jaCopy.header.navContact,
    en: enCopy.header.navContact,
  },
];

const howToUseHref = `${homePath}#howToUse`;
const desktopNavItems = defaultNavItems.filter(
  (item) => item.href !== howToUseHref,
);
const navItems = defaultNavItems;
const headerCtaHref = howToUseHref;

const siteName = t.information.name;

const socialLinks = [
  {
    label: "X",
    href: "https://x.com/one_coin_cowork",
    icon: "/icon-x.svg",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/one_coin_coworking/",
    icon: "/icon-insta.svg",
  },
  {
    label: "Threads",
    href: "https://www.threads.com/@one_coin_coworking",
    icon: "/icon-threads.svg",
  },
];
---

<header class="header">
  <div class="header__inner">
    <a href={homePath} class="logo" aria-label={siteName}>
      <span class="logo__text">{siteName}</span>
    </a>

    <div class="header__actions">
      <nav class="nav" aria-label={t.header.mainNav}>
        <ul class="nav__list">
          {
            desktopNavItems.map((item) => (
              <li>
                <a href={item.href} class="nav__link">
                  {lang === "en" ? item.en : item.ja}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="social">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="social__link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
              >
                <img
                  src={item.icon}
                  alt=""
                  class="social__icon"
                  width="18"
                  height="18"
                  decoding="async"
                />
              </a>
            </li>
          ))
        }
      </ul>

      <a class="header__cta" href={headerCtaHref}>
        <span>{t.header.headerCta}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<button
  class:list={["menu-toggle", cream && "menu-toggle--cream"]}
  type="button"
  aria-label={t.header.menuOpen}
  aria-expanded="false"
  aria-controls="mobile-nav"
  data-menu-open={t.header.menuOpen}
  data-menu-close={t.header.menuClose}
>
  <span aria-hidden="true"></span>
  <span aria-hidden="true"></span>
</button>

<nav
  id="mobile-nav"
  class:list={["mobile-nav", cream && "mobile-nav--cream"]}
  aria-label={t.header.mobileNav}
  hidden
>
  <ul>
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="mobile-nav__link"
            aria-label={lang === "en" ? item.en : item.ja}
          >
            <span class="mobile-nav__en">{item.en}</span>
            <span class="mobile-nav__sep" aria-hidden="true">
              |
            </span>
            <span class="mobile-nav__ja">{item.ja}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mobile-nav__bar">
    <ul class="social social--menu">
      {
        socialLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="social__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <img
                src={item.icon}
                alt=""
                class="social__icon"
                width="22"
                height="22"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .header {
    position: relative;
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
    margin: 0;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: none;
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 5rem) 1.75rem;
  }

  .logo {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    min-width: 0;
    font-family: "Poppins", "Zen Kaku Gothic New", sans-serif;
    font-size: clamp(0.75rem, 0.15rem + 1.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: #222;
  }

  .logo__text {
    white-space: nowrap;
  }

  .header__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 2rem);
  }

  .header__actions > .social {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 2rem);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: clamp(0.75rem, 0.55rem + 0.4vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #222;
    transition: opacity 0.2s;
  }

  .nav__link:hover {
    opacity: 0.6;
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.75rem;
    padding: 0 clamp(0.9rem, 1.4vw, 1.5rem);
    border-radius: 30px;
    background: linear-gradient(90deg, #18a15e, #039987);
    color: #fff;
    font-size: clamp(0.75rem, 0.55rem + 0.4vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social--menu {
    display: none;
  }

  .social__link {
    display: flex;
    width: 18px;
    height: 18px;
  }

  .social__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    opacity: 1;
  }

  .menu-toggle:hover,
  .menu-toggle:focus,
  .menu-toggle:focus-visible,
  .menu-toggle:active {
    opacity: 1;
  }

  .menu-toggle span {
    display: block;
    width: 0.9rem;
    height: 1.5px;
    background: #222;
  }

  .mobile-nav {
    display: none;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background-color: #fff;
    padding: 1rem 2rem 1.5rem;
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  .mobile-nav > ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav__link {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    color: #222;
  }

  .mobile-nav__en {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-nav__sep {
    font-size: 1rem;
    font-weight: 400;
    color: #000000;
  }

  .mobile-nav__ja {
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #555;
  }

  .mobile-nav__bar {
    display: none;
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .header__inner {
      padding: 1.75rem 1.25rem 1.5rem;
      gap: 0.75rem;
    }

    .logo {
      font-size: 0.9375rem;
    }

    .header__actions {
      gap: 0.75rem;
    }

    .nav__list {
      gap: 1.5rem;
    }

    .nav__link,
    .header__cta {
      font-size: 0.8125rem;
      letter-spacing: 0.02em;
    }

    .header__cta {
      height: 2.5rem;
      padding: 0 1rem;
    }
  }

  @media (max-width: 900px) {
    .header__inner {
      padding: 1.25rem 1.5rem;
    }

    .logo {
      font-size: 1.35rem;
    }

    .nav {
      display: none;
    }

    .header__cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
      position: fixed;
      top: 1.25rem;
      right: 1.5rem;
      z-index: 160;
      background-color: #fff;
      border: 1px solid #222;
      border-radius: 50%;
      isolation: isolate;
      transform: translateZ(0);
    }

    .menu-toggle--cream {
      background-color: #f9f6f1;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 150;
      margin: 0;
      border-radius: 0;
      border-top: none;
      padding: calc(1.25rem + 3.25rem + 1.25rem) 1.5rem 1.5rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background-color: #fff;
    }

    .mobile-nav--cream:not([hidden]) {
      background-color: #f9f6f1;
    }

    .mobile-nav__bar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-top: 3.5rem;
    }

    .mobile-nav:not([hidden]) .social--menu {
      display: flex;
      flex-direction: row;
      gap: 1.25rem;
    }

    .mobile-nav .social__link {
      width: 22px;
      height: 22px;
    }
  }
</style>
