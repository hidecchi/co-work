---
import { getMediaArticlePath, type Lang, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { formatMediaDate, getMediaPosts, mediaSlug } from "../utils/media";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getMediaPosts(lang);
---

<Layout lang={lang} title={t.media.title} description={t.media.description}>
  <Header lang={lang} />
  <main id="main-content" class="media-page">
    <div class="media-page__inner">
      <p class="section-label">{t.media.label}</p>
      <h1 class="media-page__heading">{t.media.heading}</h1>
      <p class="media-page__lead">{t.media.lead}</p>

      {
        posts.length === 0 ? (
          <p class="media-page__empty">{t.media.empty}</p>
        ) : (
          <ul class="media-list">
            {posts.map((post) => {
              const href = getMediaArticlePath(lang, mediaSlug(post.id));
              return (
                <li>
                  <article class="media-card">
                    {post.data.heroImage && (
                      <a href={href} class="media-card__image-link" tabindex="-1">
                        <img
                          src={post.data.heroImage}
                          alt={post.data.heroImageAlt ?? ""}
                          class="media-card__image"
                          width="640"
                          height="360"
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    )}
                    <div class="media-card__body">
                      <time
                        class="media-card__date"
                        datetime={post.data.pubDate.toISOString()}
                      >
                        {formatMediaDate(post.data.pubDate, lang)}
                      </time>
                      <h2 class="media-card__title">
                        <a href={href}>{post.data.title}</a>
                      </h2>
                      <p class="media-card__excerpt">{post.data.description}</p>
                      <a href={href} class="media-card__more">
                        {t.media.readMore}
                      </a>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </main>
  <Footer lang={lang} />
  <LanguageSwitch lang={lang} />
</Layout>

<style>
  .media-page {
    padding: 8rem 1.5rem 5rem;
    background: #fff;
    font-size: 1.125rem;
  }

  .media-page__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .media-page .section-label {
    font-size: 0.875rem;
  }

  .media-page__heading {
    margin: 0 0 1rem;
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .media-page__lead {
    margin: 0 0 2.5rem;
    color: #555;
    line-height: 1.8;
  }

  .media-page__empty {
    margin: 0;
    color: #666;
  }

  .media-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .media-card {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .media-card__image-link {
    display: block;
    overflow: hidden;
  }

  .media-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #f5f5f5;
  }

  .media-card__date {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: #888;
  }

  .media-card__title {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .media-card__title a:hover {
    opacity: 0.65;
  }

  .media-card__excerpt {
    margin: 0 0 1rem;
    color: #555;
    line-height: 1.8;
  }

  .media-card__more {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #0077ff;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .media-page {
      padding: 6.5rem 1.25rem 3.5rem;
    }

    .media-page__heading {
      font-size: 1.525rem;
    }

    .media-card__title {
      font-size: 1.25rem;
    }
  }
</style>
