---
import {
  getHomePath,
  getMediaArticlePath,
  type Lang,
  useTranslations,
} from "../i18n";
import Layout from "../layouts/Layout.astro";
import {
  formatMediaListDateParts,
  getMediaPosts,
  mediaSlug,
} from "../utils/media";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getMediaPosts(lang);
const homePath = getHomePath(lang);
---

<Layout lang={lang} title={t.media.title} description={t.media.description}>
  <Header lang={lang} />
  <div class="media-page-wrap">
    <nav class="breadcrumb" aria-label={t.media.breadcrumbLabel}>
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={homePath} class="breadcrumb__link breadcrumb__link--home">
            {t.media.breadcrumbHome}
          </a>
        </li>
        <li class="breadcrumb__item">
          <span class="breadcrumb__current" aria-current="page">
            {t.media.label}
          </span>
        </li>
      </ol>
    </nav>

    <main id="main-content" class="media-page">
      <header class="media-page__header">
        <h1 class="media-page__title">{t.media.label}</h1>
      </header>

      <div class="media-page__container">
        {
          posts.length === 0 ? (
            <p class="media-page__empty">{t.media.empty}</p>
          ) : (
            <ul class="media-list">
              {posts.map((post) => {
                const href = getMediaArticlePath(lang, mediaSlug(post.id));
                const dateParts = formatMediaListDateParts(post.data.pubDate);

                return (
                  <li>
                    <article class="media-card">
                      {post.data.heroImage && (
                        <a
                          href={href}
                          class="media-card__image-link"
                          tabindex="-1"
                        >
                          <img
                            src={post.data.heroImage}
                            alt={post.data.heroImageAlt ?? ""}
                            class="media-card__image"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      )}
                      <div class="media-card__body">
                        <div class="media-card__date">
                          <time datetime={post.data.pubDate.toISOString()}>
                            <span class="media-card__date-year">
                              {dateParts.year}
                            </span>
                            <span class="media-card__date-day">
                              {dateParts.monthDay}
                            </span>
                          </time>
                        </div>
                        <h2 class="media-card__title">
                          <a href={href}>{post.data.title}</a>
                        </h2>
                        <p class="media-card__excerpt">
                          {post.data.description}
                        </p>
                        <div class="media-card__cta">
                          <a href={href} class="media-card__more">
                            <span>{t.media.readMore}</span>
                            <span class="media-card__more-icon" />
                          </a>
                        </div>
                      </div>
                    </article>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    </main>
  </div>
  <Footer lang={lang} />
  <LanguageSwitch lang={lang} />
</Layout>

<style>
  .media-page-wrap {
    padding-top: 5rem;
  }

  .breadcrumb {
    border-top: 1px solid #eee;
    background: #fff;
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 49px;
    list-style: none;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: #666;
  }

  .breadcrumb__link {
    position: relative;
    padding: 0 1.75rem 0 0.75rem;
    color: #666;
  }

  .breadcrumb__link--home {
    padding-left: 0;
  }

  .breadcrumb__link::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.375rem;
    width: 0.375rem;
    height: 0.375rem;
    border-top: 1px solid #bbb;
    border-right: 1px solid #bbb;
    transform: translateY(-50%) rotate(45deg);
  }

  .breadcrumb__current {
    color: #000;
  }

  .media-page {
    padding-bottom: 6.5rem;
    background: #f2f2f5;
  }

  .media-page__header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    background: #f2f2f5;
  }

  .media-page__title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .media-page__container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .media-page__empty {
    margin: 0;
    padding: 3rem 0;
    text-align: center;
    color: #666;
  }

  .media-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .media-card {
    background: #fff;
    margin-bottom: 50px;
  }

  .media-card__image-link {
    display: block;
    overflow: hidden;
  }

  .media-card__image-link:hover img {
    opacity: 0.6;
  }

  .media-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #e8e8ec;
    transition: opacity 0.2s;
  }

  .media-card__body {
    position: relative;
    min-height: 180px;
  }

  .media-card__date {
    position: absolute;
    top: 0;
    left: 0;
    width: 180px;
    height: 180px;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-card__date time {
    display: block;
    text-align: center;
  }

  .media-card__date-year {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.125rem;
  }

  .media-card__date-day {
    display: block;
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.1;
  }

  .media-card__title {
    margin: 0 0 0.9375rem;
    padding: 1.75rem 3.4375rem 0 14.25rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .media-card__title a {
    color: #000;
  }

  .media-card__excerpt {
    margin: 0 0 0.625rem;
    padding: 0 3.4375rem 0 14.25rem;
    font-size: 1rem;
    line-height: 1.8;
    color: #666;
  }

  .media-card__cta {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 130px;
    height: 50px;
  }

  .media-card__more {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.375rem;
    width: 100%;
    height: 100%;
    padding-right: 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #000;
  }

  .media-card__more:hover {
    background: #e8f3f7;
    opacity: 1;
  }

  .media-card__more-icon {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 10px;
    flex-shrink: 0;
  }

  .media-card__more-icon::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 14px;
    height: 1px;
    background-color: currentColor;
  }

  .media-card__more-icon::after {
    content: "";
    position: absolute;
    left: 13px;
    bottom: 2px;
    width: 1px;
    height: 9px;
    background-color: currentColor;
    transform-origin: bottom left;
    transform: rotate(-45deg);
  }

  @media (max-width: 768px) {
    .media-page-wrap {
      padding-top: 4.5rem;
    }

    .breadcrumb__list {
      height: auto;
      min-height: 44px;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .media-page__header {
      height: auto;
      padding: 3rem 0 2rem;
    }

    .media-page__title {
      font-size: 1.375rem;
    }

    .media-card {
      margin-bottom: 2.5rem;
    }

    .media-card__body {
      position: static;
      min-height: auto;
      padding: 1.75rem 1.5rem;
    }

    .media-card__date {
      position: static;
      width: auto;
      height: auto;
      background: transparent;
      color: inherit;
      display: block;
      margin-bottom: 1rem;
    }

    .media-card__date-year,
    .media-card__date-day {
      display: inline;
      font-size: 0.75rem;
      font-weight: 400;
    }

    .media-card__date-year::after {
      content: ".";
    }

    .media-card__title,
    .media-card__excerpt {
      padding: 0;
    }

    .media-card__title {
      font-size: 1.125rem;
    }

    .media-card__cta {
      position: static;
      width: auto;
      height: auto;
      margin-top: 1rem;
    }

    .media-card__more {
      justify-content: flex-start;
      padding: 0;
      width: auto;
      height: auto;
    }
  }
</style>
