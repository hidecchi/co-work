---
import { getAlternatePath, type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternatePath = getAlternatePath(lang, Astro.url.pathname);
const alternateLang = lang === "ja" ? "en" : "ja";

const socialLinks = [
  {
    label: "Threads",
    href: "https://www.threads.com/@one_coin_coworking",
    icon: "/icon-threads.svg",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/one_coin_coworking/",
    icon: "/icon-insta.svg",
  },
  {
    label: "X",
    href: "https://x.com/one_coin_cowork",
    icon: "/icon-x.svg",
  },
];
---

<div class="lang-banner">
  <a
    href={alternatePath}
    class="lang-banner__lang"
    lang={alternateLang}
    aria-label={t.header.langSwitchAria}
  >
    <span class="lang-banner__icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none">
        <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          d="M2 10h16M10 2c2.5 2.2 2.5 13.8 0 16M10 2c-2.5 2.2-2.5 13.8 0 16"
          stroke="currentColor"
          stroke-width="1.5"></path>
      </svg>
    </span>
    <span class="lang-banner__text">{t.header.langSwitch}</span>
  </a>
  <span class="lang-banner__sep" aria-hidden="true"></span>
  <ul class="lang-banner__social">
    {
      socialLinks.map((item) => (
        <li>
          <a
            href={item.href}
            class="lang-banner__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
          >
            <img
              src={item.icon}
              alt=""
              width="18"
              height="18"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-banner {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: max-content;
    gap: 0.9rem;
    padding: 0.7rem 1.4rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #444444;
    border-radius: 999px;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08),
      0 6px 24px rgba(0, 0, 0, 0.1);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    backdrop-filter: blur(8px);
  }

  .lang-banner__lang {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    white-space: nowrap;
  }

  .lang-banner__icon {
    display: flex;
    width: 1.125rem;
    height: 1.125rem;
    color: #444444;
  }

  .lang-banner__icon svg {
    width: 100%;
    height: 100%;
  }

  .lang-banner__sep {
    display: block;
    width: 1px;
    height: 1.15em;
    background: #444444;
    flex-shrink: 0;
  }

  .lang-banner__social {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-banner__social li {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.9rem;
  }

  .lang-banner__social li:not(:last-child)::after {
    content: "";
    width: 1px;
    height: 1.15em;
    background: #444444;
  }

  .lang-banner__social-link {
    display: flex;
    width: 18px;
    height: 18px;
  }

  .lang-banner__social-link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }

  @media (max-width: 900px) {
    .lang-banner {
      right: 1rem;
      bottom: 1rem;
      gap: 0.5rem;
      padding: 0.625rem 1rem;
      font-size: 0.8125rem;
    }

    .lang-banner__sep,
    .lang-banner__social {
      display: none;
    }
  }
</style>
