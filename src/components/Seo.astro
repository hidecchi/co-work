---
import { siteConfig } from "../config/site";
import {
  getAlternateLang,
  getAlternatePath,
  getHomePath,
  useTranslations,
  type Lang,
} from "../i18n";
import { getSiteOrigin, toAbsoluteUrl } from "../utils/site-url";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  keywords?: string[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const lang = Astro.props.lang ?? "ja";
const t = useTranslations(lang);

const {
  title = t.seo.title,
  description = t.seo.description,
  image = siteConfig.ogImage,
  imageAlt = t.seo.ogImageAlt,
  noindex = false,
  canonical,
  ogType = "website",
  keywords = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteOrigin = getSiteOrigin(Astro.site?.href, import.meta.env.SITE);
const canonicalURL =
  canonical ?? toAbsoluteUrl(Astro.url.pathname, siteOrigin);
const ogImageURL = toAbsoluteUrl(image, siteOrigin);
const siteName = t.information.name;
const pageTitle =
  title === t.seo.title || title.endsWith(` | ${siteName}`)
    ? title
    : `${title} | ${siteName}`;

const alternateLang = getAlternateLang(lang);
const alternateURL = toAbsoluteUrl(
  getAlternatePath(lang, Astro.url.pathname),
  siteOrigin,
);
const defaultURL = toAbsoluteUrl(getHomePath("ja"), siteOrigin);

const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "CoworkingSpace",
  name: t.information.name,
  description: t.seo.description,
  url: toAbsoluteUrl(getHomePath(lang), siteOrigin),
  image: ogImageURL,
  priceRange: siteConfig.business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress:
      lang === "en"
        ? siteConfig.business.streetAddressEn
        : siteConfig.business.streetAddress,
    addressLocality:
      lang === "en"
        ? siteConfig.business.addressLocalityEn
        : siteConfig.business.addressLocality,
    addressRegion: siteConfig.business.addressRegion,
    postalCode: siteConfig.business.postalCode,
    addressCountry: siteConfig.business.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: siteConfig.business.latitude,
    longitude: siteConfig.business.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
};

const articleJsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        url: canonicalURL,
        image: ogImageURL,
        inLanguage: t.seo.locale,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: {
          "@type": "Organization",
          name: siteName,
        },
        publisher: {
          "@type": "Organization",
          name: siteName,
        },
        keywords: keywords.join(", "),
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL,
        },
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
{
  keywords.length > 0 && (
    <meta name="keywords" content={keywords.join(", ")} />
  )
}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta name="theme-color" content={siteConfig.themeColor} />
<meta name="format-detection" content="telephone=no" />

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={t.seo.locale} href={canonicalURL} />
<link rel="alternate" hreflang={alternateLang} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={defaultURL} />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta property="og:type" content={ogType} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  (modifiedTime ?? publishedTime) && ogType === "article" && (
    <meta
      property="article:modified_time"
      content={(modifiedTime ?? publishedTime)?.toISOString()}
    />
  )
}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={t.seo.ogLocale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content={siteConfig.twitterCard} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
{
  articleJsonLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleJsonLd)}
    />
  )
}

<title>{pageTitle}</title>
