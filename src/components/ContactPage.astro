---
import { getHomePath, type Lang, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import ContactForm from "./ContactForm.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getHomePath(lang);
---

<Layout
  lang={lang}
  title={t.contact.title}
  description={t.contact.description}
>
  <Header lang={lang} />
  <div class="contact-page-wrap">
    <nav class="breadcrumb" aria-label={t.contact.breadcrumbLabel}>
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={homePath} class="breadcrumb__link breadcrumb__link--home">
            {t.media.breadcrumbHome}
          </a>
        </li>
        <li class="breadcrumb__item">
          <span class="breadcrumb__current" aria-current="page">
            {t.contact.label}
          </span>
        </li>
      </ol>
    </nav>

    <main id="main-content" class="contact-page">
      <header class="contact-page__header">
        <h1 class="contact-page__title">{t.contact.label}</h1>
      </header>

      <div class="contact-page__container">
        <p class="contact-page__lead">{t.contact.lead}</p>
        <ContactForm lang={lang} />
      </div>
    </main>
  </div>
  <Footer lang={lang} />
  <LanguageSwitch lang={lang} />
</Layout>

<style>
  .contact-page-wrap {
    padding-top: 5rem;
  }

  .breadcrumb {
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    background: #fff;
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 49px;
    list-style: none;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: #666;
  }

  .breadcrumb__link {
    position: relative;
    padding: 0 1.75rem 0 0.75rem;
    color: #666;
  }

  .breadcrumb__link--home {
    padding-left: 0;
  }

  .breadcrumb__link::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.375rem;
    width: 0.375rem;
    height: 0.375rem;
    border-top: 1px solid #bbb;
    border-right: 1px solid #bbb;
    transform: translateY(-50%) rotate(45deg);
  }

  .breadcrumb__current {
    color: #000;
  }

  .contact-page {
    padding-bottom: 6.5rem;
    background: #fff;
  }

  .contact-page__header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    background: #fff;
  }

  .contact-page__title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .contact-page__container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.5rem 3.5rem;
  }

  .contact-page__lead {
    margin: 0 0 2.25rem;
    font-size: 1rem;
    line-height: 1.8;
    color: #666;
  }

  @media (max-width: 768px) {
    .contact-page-wrap {
      padding-top: 4.5rem;
    }

    .breadcrumb__list {
      height: auto;
      min-height: 44px;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .contact-page__header {
      height: auto;
      padding: 3rem 0 2rem;
    }

    .contact-page__title {
      font-size: 1.375rem;
    }

    .contact-page__container {
      padding-bottom: 2.5rem;
    }
  }
</style>
